{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private prospective Quiver activity receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["activity_id", "operation_id", "response_id", "actions", "manifest_complete", "started_at", "ended_at", "outcome"],
  "properties": {
    "activity_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "response_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "manifest_complete": {"type": "boolean"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "outcome": {"enum": ["completed", "failed", "cancelled", "unknown"]},
    "tool_seconds": {"type": ["number", "null"], "minimum": 0}
  }
}
