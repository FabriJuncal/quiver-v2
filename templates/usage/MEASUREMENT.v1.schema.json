{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiver.local/schemas/plan-usage-measurement-v1.json",
  "title": "Quiver plan usage measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "binding", "usage", "data_state", "unknowns", "anomalies", "source"],
  "properties": {
    "report_version": {"const": 1},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "project_id", "requirement_ref", "plan_version", "plan_digest", "execution_id", "attempt_id", "slice_id", "source_version", "enabled"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project_id": {"type": "string", "minLength": 1},
        "requirement_ref": {"type": "string", "minLength": 1},
        "plan_version": {"type": "string", "minLength": 1},
        "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "execution_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "slice_id": {"type": ["string", "null"]},
        "source_version": {"const": "0.156.1"},
        "enabled": {"type": "boolean"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responses", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "cache_write_input_tokens", "total_tokens"],
      "properties": {
        "responses": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "data_state": {"enum": ["provisional", "incomplete"]},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "anomalies": {"type": "array", "items": {"type": "object"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter_version"],
      "properties": {
        "kind": {"const": "codex_rollout_jsonl"},
        "adapter_version": {"const": 1}
      }
    }
  }
}
