{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiver.local/schemas/plan-usage-measurement-v2.json",
  "title": "Quiver plan usage measurement v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "revision", "binding", "identity", "usage", "lifecycle", "times", "outcomes", "cost", "data_state", "unknowns", "anomalies", "source"],
  "properties": {
    "report_version": {"const": 2},
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "persisted", "supersedes", "reason"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "persisted": {"type": "boolean"},
        "supersedes": {"type": ["integer", "null"], "minimum": 1},
        "reason": {"enum": ["initial", "update", "late_event"]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "project_id", "requirement_ref", "plan_version", "plan_digest", "execution_id", "attempt_id", "slice_id", "source_version", "enabled"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project_id": {"type": "string", "minLength": 1},
        "requirement_ref": {"type": "string", "minLength": 1},
        "plan_version": {"type": "string", "minLength": 1},
        "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "execution_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "slice_id": {"type": ["string", "null"]},
        "source_version": {"const": "0.156.1"},
        "enabled": {"type": "boolean"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_model", "service_tier", "payment_mode"],
      "properties": {
        "effective_model": {"type": ["string", "null"]},
        "service_tier": {"type": ["string", "null"]},
        "payment_mode": {"type": ["string", "null"]}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["responses", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "cache_write_input_tokens", "total_tokens"],
      "properties": {
        "responses": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["technical_status", "acceptance_status", "acceptance_reference", "event_count"],
      "properties": {
        "technical_status": {"enum": ["unobserved", "open", "closed", "cancelled"]},
        "acceptance_status": {"enum": ["pending", "accepted"]},
        "acceptance_reference": {"type": ["string", "null"]},
        "event_count": {"type": "integer", "minimum": 0}
      }
    },
    "times": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "ended_at", "elapsed_seconds", "paused_seconds", "unpaused_seconds", "active_time_seconds", "wait_time_seconds", "agent_time_seconds"],
      "properties": {
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]},
        "elapsed_seconds": {"type": ["string", "null"]},
        "paused_seconds": {"type": ["string", "null"]},
        "unpaused_seconds": {"type": ["string", "null"]},
        "active_time_seconds": {"type": "null"},
        "wait_time_seconds": {"type": "null"},
        "agent_time_seconds": {"type": "null"}
      }
    },
    "outcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["failures", "retries", "cancellations", "missing_usage_events"],
      "properties": {
        "failures": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "cancellations": {"type": "integer", "minimum": 0},
        "missing_usage_events": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "nature", "amount", "billed_amount", "rate_snapshot_id", "priced_responses", "unpriced_responses"],
      "properties": {
        "currency": {"const": "USD"},
        "nature": {"enum": ["unknown", "synthetic_api_equivalent_subtotal"]},
        "amount": {"type": ["string", "null"]},
        "billed_amount": {"type": "null"},
        "rate_snapshot_id": {"type": ["string", "null"]},
        "priced_responses": {"type": "integer", "minimum": 0},
        "unpriced_responses": {"type": "integer", "minimum": 0}
      }
    },
    "data_state": {"enum": ["provisional", "incomplete"]},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "anomalies": {"type": "array", "items": {"type": "object"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "adapter_version"],
      "properties": {
        "kind": {"const": "codex_rollout_jsonl"},
        "adapter_version": {"const": 1}
      }
    }
  }
}
